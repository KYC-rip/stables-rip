    "a8": "\u540c\u3058\u3053\u3068\u3092\u6307\u3057\u307e\u3059\u3002\u300c\u30d6\u30e9\u30c3\u30af\u30ea\u30b9\u30c8\u300d\u306f\u30b9\u30de\u30fc\u30c8\u30b3\u30f3\u30c8\u30e9\u30af\u30c8\u30b3\u30fc\u30c9\u306e\u6280\u8853\u7528\u8a9e\u3067\u3059\u3002\u300c\u51cd\u7d50\u300d\u306f\u5b9f\u969b\u306e\u52b9\u679c\u3092\u8868\u3057\u307e\u3059\u2014\u2014\u30c8\u30fc\u30af\u30f3\u3092\u79fb\u52d5\u3067\u304d\u306a\u3044\u3053\u3068\u3002\u4e00\u90e8\u306e\u30d6\u30e9\u30c3\u30af\u30ea\u30b9\u30c8\u30a2\u30c9\u30ec\u30b9\u304c $0 \u306e\u6b8b\u9ad8\u3092\u8868\u793a\u3059\u308b\u306e\u306f\u3001\u51cd\u7d50\u524d\u306b\u30c8\u30fc\u30af\u30f3\u304c\u79fb\u52d5\u3055\u308c\u305f\u305f\u3081\u3067\u3059\u3002",

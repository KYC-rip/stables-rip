    "total_frozen": "\u0412\u0441\u0435\u0433\u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043e",
    "addresses": "\u0410\u0434\u0440\u0435\u0441\u0430",
    "chains_monitored": "\u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0445 \u0441\u0435\u0442\u0435\u0439",
    "assets_tracked": "\u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0445 \u0430\u043a\u0442\u0438\u0432\u043e\u0432",
    "by_asset": "\u041f\u043e \u0430\u043a\u0442\u0438\u0432\u0430\u043c",
    "volume_frozen": "\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u043e\u0431\u044a\u0451\u043c",
    "by_chain": "\u041f\u043e \u0441\u0435\u0442\u044f\u043c",
    "monthly_activity": "\u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c",
    "col_month": "\u041c\u0435\u0441\u044f\u0446",
    "col_addresses_frozen": "\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043e \u0430\u0434\u0440\u0435\u0441\u043e\u0432",
    "col_volume": "\u041e\u0431\u044a\u0451\u043c",
    "loading": "\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430...",

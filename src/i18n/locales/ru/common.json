    "seo_title": "\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u2014 stables.rip",
    "seo_description": "\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432: \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0435 \u0442\u0440\u0435\u043d\u0434\u044b, \u0430\u043d\u0430\u043b\u0438\u0437 \u043f\u043e \u0441\u0435\u0442\u044f\u043c \u0438 \u043d\u0430\u043a\u043e\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043e\u0431\u044a\u0451\u043c \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043e\u043a."
  },
  "faq_page": {
    "title": "\u0427\u0430\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b",
    "subtitle": "\u0412\u0441\u0451, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0437\u043d\u0430\u0442\u044c \u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0435 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432, \u0447\u0451\u0440\u043d\u044b\u0445 \u0441\u043f\u0438\u0441\u043a\u0430\u0445 \u0438 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u043e\u043d\u0447\u0435\u0439\u043d-\u0446\u0435\u043d\u0437\u0443\u0440\u044b.",
    "seo_title": "\u0427\u0430\u0412\u043e \u2014 stables.rip",
    "seo_description": "\u0427\u0430\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0435 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432, \u0447\u0451\u0440\u043d\u044b\u0445 \u0441\u043f\u0438\u0441\u043a\u0430\u0445 USDC \u0438 USDT, \u0438 \u043a\u0430\u043a stables.rip \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u0442 \u043e\u043d\u0447\u0435\u0439\u043d-\u0446\u0435\u043d\u0437\u0443\u0440\u0443.",
    "q1": "\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432?",
    "a1": "\u042d\u043c\u0438\u0442\u0435\u043d\u0442\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a Circle (USDC) \u0438 Tether (USDT), \u0438\u043c\u0435\u044e\u0442 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0447\u0451\u0440\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430 \u0432 \u0441\u043c\u0430\u0440\u0442-\u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0430\u0445. \u041a\u043e\u0433\u0434\u0430 \u0430\u0434\u0440\u0435\u0441 \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0432 \u0447\u0451\u0440\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a, \u0442\u043e\u043a\u0435\u043d\u044b \u043d\u0430 \u044d\u0442\u043e\u043c \u0430\u0434\u0440\u0435\u0441\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0435\u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u043c\u0438. \u0412\u043b\u0430\u0434\u0435\u043b\u0435\u0446 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c, \u043e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u0442\u044c \u0438\u043b\u0438 \u043a\u0430\u043a-\u043b\u0438\u0431\u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441 \u044d\u0442\u0438\u043c\u0438 \u0442\u043e\u043a\u0435\u043d\u0430\u043c\u0438.",
    "q2": "\u041a\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c \u043a\u043e\u0448\u0435\u043b\u0451\u043a \u0441\u043e \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u0430\u043c\u0438?",
    "a2": "\u0422\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f-\u044d\u043c\u0438\u0442\u0435\u043d\u0442. Circle \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0447\u0451\u0440\u043d\u044b\u043c \u0441\u043f\u0438\u0441\u043a\u043e\u043c USDC, Tether \u2014 USDT. \u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 \u043e\u0431\u044b\u0447\u043d\u043e \u0438\u043d\u0438\u0446\u0438\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u043f\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430\u043c \u043f\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u0434\u043b\u044f \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0441\u0430\u043d\u043a\u0446\u0438\u0439 OFAC \u0438\u043b\u0438 \u043f\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 \u043e\u0446\u0435\u043d\u043a\u0435 \u0440\u0438\u0441\u043a\u043e\u0432. \u041f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u043e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435\u0442.",
    "q3": "\u041c\u043e\u0436\u0435\u0442 \u043b\u0438 USDC \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c \u043c\u043e\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430?",
    "a3": "\u0414\u0430. \u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c USDC \u0432 \u043b\u044e\u0431\u043e\u043c \u043d\u0435\u043a\u0430\u0441\u0442\u043e\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u043a\u043e\u0448\u0435\u043b\u044c\u043a\u0435, Circle \u043c\u043e\u0436\u0435\u0442 \u0432 \u043b\u044e\u0431\u043e\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0430\u0448 \u0430\u0434\u0440\u0435\u0441. \u042d\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f Ethereum, TRON \u0438 \u0432\u0441\u0435\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0435\u0442\u0435\u0439. \u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0441\u043c\u0430\u0440\u0442-\u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0430 \u2014 \u043d\u0438 \u043e\u0434\u043d\u0430 \u0431\u0438\u0440\u0436\u0430 \u0438\u043b\u0438 \u043a\u043e\u0448\u0435\u043b\u0451\u043a \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u044d\u0442\u043e \u043e\u0431\u043e\u0439\u0442\u0438.",
    "q4": "\u041c\u043e\u0436\u0435\u0442 \u043b\u0438 USDT \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c \u043c\u043e\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430?",
    "a4": "\u0414\u0430. Tether \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043b \u0441\u043e\u0442\u043d\u0438 \u0430\u0434\u0440\u0435\u0441\u043e\u0432 \u0432 \u0441\u0435\u0442\u044f\u0445 Ethereum \u0438 TRON. \u041f\u043e\u0441\u043b\u0435 \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u044f \u0432 \u0447\u0451\u0440\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a USDT \u043d\u0430 \u044d\u0442\u043e\u043c \u0430\u0434\u0440\u0435\u0441\u0435 \u0437\u0430\u043c\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430. \u0412\u0441\u0435\u0433\u043e Tether \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u0438\u043b \u0431\u043e\u043b\u0435\u0435 $1 \u043c\u043b\u0440\u0434 \u043d\u0430 \u0432\u0441\u0435\u0445 \u0441\u0435\u0442\u044f\u0445.",
    "q5": "\u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430 \u2014 \u044d\u0442\u043e \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435, \u0447\u0442\u043e \u043a\u043e\u043d\u0444\u0438\u0441\u043a\u0430\u0446\u0438\u044f?",
    "a5": "\u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430 \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0443 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0442\u044c \u0442\u043e\u043a\u0435\u043d\u044b, \u043d\u043e \u043e\u043d\u0438 \u043d\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u044e\u0442\u0441\u044f \u0438 \u043d\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0442\u0441\u044f. \u041e\u043d\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u043e\u043c \u0430\u0434\u0440\u0435\u0441\u0435 \u0431\u0435\u0441\u0441\u0440\u043e\u0447\u043d\u043e. \u0418\u043d\u043e\u0433\u0434\u0430 \u043f\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043e\u0440\u0433\u0430\u043d\u044b \u043c\u043e\u0433\u0443\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441 \u044d\u043c\u0438\u0442\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u0441\u0440\u0435\u0434\u0441\u0442\u0432, \u043d\u043e \u044d\u0442\u043e \u0440\u0435\u0434\u043a\u043e\u0441\u0442\u044c.",
    "q6": "\u041a\u0430\u043a stables.rip \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438?",
    "a6": "\u041c\u044b \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043c \u043e\u043d\u0447\u0435\u0439\u043d-\u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0441\u043c\u0430\u0440\u0442-\u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u043e\u0432 USDC \u0438 USDT \u0432 Ethereum \u0438 TRON. \u041a\u043e\u0433\u0434\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u0447\u0451\u0440\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430 (AddedBlackList, Blacklisted) \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044f, \u043c\u044b \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c \u0430\u0434\u0440\u0435\u0441, \u0445\u044d\u0448 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438, \u043c\u0435\u0442\u043a\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0431\u0430\u043b\u0430\u043d\u0441. \u0414\u0430\u043d\u043d\u044b\u0435 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0435 30 \u043c\u0438\u043d\u0443\u0442.",
    "q7": "\u041e\u0442\u043a\u0443\u0434\u0430 \u0431\u0435\u0440\u0443\u0442\u0441\u044f \u0434\u0430\u043d\u043d\u044b\u0435?",
    "a7": "\u0421\u043e\u0431\u044b\u0442\u0438\u044f \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 Ethereum \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 API \u043b\u043e\u0433\u043e\u0432 Etherscan, \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u044f \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u0434\u0440\u0435\u0441\u0430 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u043e\u0432 USDT \u0438 USDC. \u0421\u043e\u0431\u044b\u0442\u0438\u044f TRON \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u044e\u0442 \u0438\u0437 TronGrid API. \u0411\u0430\u043b\u0430\u043d\u0441\u044b \u0432\u0435\u0440\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u043e\u043d\u0447\u0435\u0439\u043d multicall-\u0437\u0430\u043f\u0440\u043e\u0441\u044b.",
    "q8": "\u0427\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u0432 \u0447\u0451\u0440\u043d\u043e\u043c \u0441\u043f\u0438\u0441\u043a\u0435\u00bb \u0438 \u00ab\u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043e\u00bb?",
    "a8": "\u042d\u0442\u043e \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435. \u00ab\u0427\u0451\u0440\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a\u00bb \u2014 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0435\u0440\u043c\u0438\u043d \u0432 \u043a\u043e\u0434\u0435 \u0441\u043c\u0430\u0440\u0442-\u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0430. \u00ab\u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430\u00bb \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u0444\u0444\u0435\u043a\u0442 \u2014 \u0442\u043e\u043a\u0435\u043d\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0430\u0434\u0440\u0435\u0441\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0431\u0430\u043b\u0430\u043d\u0441 $0, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u043e\u043a\u0435\u043d\u044b \u0431\u044b\u043b\u0438 \u0432\u044b\u0432\u0435\u0434\u0435\u043d\u044b \u0434\u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438.",
    "q9": "\u041c\u043e\u0436\u043d\u043e \u043b\u0438 \u0440\u0430\u0437\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u044b?",
    "a9": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u0430 \u2014 \u0432 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0430\u0445 \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u0438 removeBlackList / unBlacklist. \u041d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 \u0440\u0430\u0437\u043c\u043e\u0440\u043e\u0437\u043a\u0438 \u043a\u0440\u0430\u0439\u043d\u0435 \u0440\u0435\u0434\u043a\u0438. \u041c\u044b \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u043c \u043a\u0430\u043a \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438, \u0442\u0430\u043a \u0438 \u0440\u0430\u0437\u043c\u043e\u0440\u043e\u0437\u043a\u0438.",
    "q10": "\u041a\u0430\u043a \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438?",
    "a10": "\u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u2014 \u043d\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0437\u0430\u043c\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0435 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u044b. \u041a\u0440\u0438\u043f\u0442\u043e\u0432\u0430\u043b\u044e\u0442\u044b \u0441 \u043a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 Monero (XMR), \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u0447\u0451\u0440\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430, \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u043c\u0438\u0442\u0435\u043d\u0442\u0430 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438. \u041e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u044b \u043d\u0430 XMR \u0431\u0435\u0437 KYC \u043c\u043e\u0436\u043d\u043e \u043d\u0430 kyc.rip.",
    "q11": "\u042d\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432 \u043d\u0430 \u0431\u0438\u0440\u0436\u0430\u0445?",
    "a11": "\u041a\u043e\u0433\u0434\u0430 \u0432\u044b \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u044b \u043d\u0430 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0431\u0438\u0440\u0436\u0435, \u0431\u0438\u0440\u0436\u0430 \u0445\u0440\u0430\u043d\u0438\u0442 \u0442\u043e\u043a\u0435\u043d\u044b \u0432 \u0441\u0432\u043e\u0451\u043c \u043a\u043e\u0448\u0435\u043b\u044c\u043a\u0435. \u0415\u0441\u043b\u0438 \u043a\u043e\u0448\u0435\u043b\u0451\u043a \u0431\u0438\u0440\u0436\u0438 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u044f\u0442 (\u0440\u0435\u0434\u043a\u043e, \u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e), \u0432\u0430\u0448\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043f\u043e\u0441\u0442\u0440\u0430\u0434\u0430\u044e\u0442. \u0427\u0430\u0449\u0435 \u0431\u0438\u0440\u0436\u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044e\u0442 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f, \u0437\u0430\u043c\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u044f \u0432\u0430\u0448 \u0430\u043a\u043a\u0430\u0443\u043d\u0442.",
    "q12": "\u041a\u0430\u043a\u0438\u0435 \u0441\u0435\u0442\u0438 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u044f\u0442\u0441\u044f?",
    "a12": "\u0421\u0435\u0439\u0447\u0430\u0441 \u043c\u044b \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043c Ethereum (ETH) \u0438 TRON \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 USDT \u0438 USDC. Ethereum \u2014 \u043b\u0438\u0434\u0435\u0440 \u043f\u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0435 USDC, TRON \u2014 \u043f\u043e USDT. \u0412 \u043f\u043b\u0430\u043d\u0430\u0445 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c Arbitrum, Optimism \u0438 Polygon.",
    "q13": "stables.rip \u0441\u0432\u044f\u0437\u0430\u043d \u0441 Circle \u0438\u043b\u0438 Tether?",
    "a13": "\u041d\u0435\u0442. stables.rip \u2014 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0439 \u043f\u0440\u043e\u0435\u043a\u0442 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u044d\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u044b rip.family (kyc.rip). \u041c\u044b \u043d\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u043d\u0438 \u0441 \u043e\u0434\u043d\u0438\u043c \u044d\u043c\u0438\u0442\u0435\u043d\u0442\u043e\u043c. \u0412\u0441\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u0437 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u0431\u043b\u043e\u043a\u0447\u0435\u0439\u043d-\u0437\u0430\u043f\u0438\u0441\u0435\u0439.",
    "q14": "\u041a\u0430\u043a \u0447\u0430\u0441\u0442\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0434\u0430\u043d\u043d\u044b\u0435?",
    "a14": "\u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0435 30 \u043c\u0438\u043d\u0443\u0442 \u0447\u0435\u0440\u0435\u0437 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 cron-\u0437\u0430\u0434\u0430\u0447\u0438. \u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0431\u0430\u043b\u0430\u043d\u0441\u043e\u0432 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u0438. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u00ab\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u00bb \u043d\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u0438."
  },
  "blacklist_page": {
    "title": "\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0447\u0451\u0440\u043d\u044b\u0435 \u0441\u043f\u0438\u0441\u043a\u0438 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432",
    "subtitle": "\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 USDC \u0438 USDT \u0438 \u0447\u0442\u043e \u044d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442 \u0434\u043b\u044f \u0432\u0430\u0448\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432.",
    "seo_title": "\u0427\u0451\u0440\u043d\u044b\u0435 \u0441\u043f\u0438\u0441\u043a\u0438 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432 \u2014 stables.rip",
    "seo_description": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 USDC \u0438 USDT. \u0423\u0437\u043d\u0430\u0439\u0442\u0435 \u043e \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430\u0445 \u0447\u0451\u0440\u043d\u044b\u0445 \u0441\u043f\u0438\u0441\u043a\u043e\u0432 Circle \u0438 Tether.",
    "usdc_title": "\u0427\u0451\u0440\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a Circle",
    "usdc_p1": "Circle, \u044d\u043c\u0438\u0442\u0435\u043d\u0442 USDC, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0447\u0451\u0440\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0430 \u0432 \u0441\u043c\u0430\u0440\u0442-\u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0435 USDC \u043d\u0430 Ethereum (\u0438 \u0432\u0441\u0435\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0435\u0442\u044f\u0445). \u0424\u0443\u043d\u043a\u0446\u0438\u044e blacklist(address) \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0437\u0432\u0430\u0442\u044c \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044b\u0439 Circle \u0430\u0434\u0440\u0435\u0441.",
    "usdc_p2": "\u041f\u043e\u0441\u043b\u0435 \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u044f \u0432 \u0447\u0451\u0440\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0432\u0441\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b USDC \u0441/\u043d\u0430 \u044d\u0442\u043e\u0442 \u0430\u0434\u0440\u0435\u0441 \u043e\u0442\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f. \u0422\u043e\u043a\u0435\u043d\u044b \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f, \u043d\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0435\u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u044b. Circle \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u044d\u0442\u0443 \u0432\u043b\u0430\u0441\u0442\u044c \u0434\u043b\u044f \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0441\u0430\u043d\u043a\u0446\u0438\u0439 OFAC, \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432 \u043f\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438 \u0440\u0438\u0441\u043a\u043e\u0432.",
    "usdc_p3": "Circle \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u0438, \u043d\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435. \u041f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u043e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435\u0442.",
    "usdt_title": "\u0427\u0451\u0440\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a Tether",
    "usdt_p1": "\u041a\u043e\u043d\u0442\u0440\u0430\u043a\u0442 USDT \u043d\u0430 Ethereum \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 addBlackList(address) \u0438 destroyBlackFunds(address). \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 USDC, Tether \u043c\u043e\u0436\u0435\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c, \u043d\u043e \u0438 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u0442\u044c \u0442\u043e\u043a\u0435\u043d\u044b.",
    "usdt_p2": "\u041d\u0430 TRON USDT \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0442\u043e\u0442 \u0436\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c AddedBlackList. \u0418\u0437-\u0437\u0430 \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f TRON \u0434\u043b\u044f P2P-\u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u0432, TRON \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0434\u043e\u043b\u044e \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043e\u043a USDT.",
    "usdt_p3": "Tether \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u044b\u043b \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0435\u0435 Circle \u0432 \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430\u0445. \u041e\u043d\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u0447\u0430\u043b\u0438 \u0441 \u043f\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043e\u0440\u0433\u0430\u043d\u0430\u043c\u0438 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443 \u0438 \u0437\u0430\u043c\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u043b\u0438 \u0430\u0434\u0440\u0435\u0441\u0430 \u043f\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430\u043c DOJ, \u0418\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u0430 \u0438 OFAC.",
    "technical_title": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438",
    "technical_p1": "\u041a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u044b \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u043e\u0432 \u0440\u0435\u0430\u043b\u0438\u0437\u0443\u044e\u0442 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 (notBlacklisted) \u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445 transfer() \u0438 transferFrom(). \u041e\u043d \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u043c\u0430\u043f\u043f\u0438\u043d\u0433 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0430\u0434\u0440\u0435\u0441\u043e\u0432 \u043f\u0435\u0440\u0435\u0434 \u043b\u044e\u0431\u044b\u043c \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c.",
    "technical_p2": "\u041f\u0440\u0438 \u0432\u044b\u0437\u043e\u0432\u0435 transfer() \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442, \u0435\u0441\u0442\u044c \u043b\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u0438\u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u044c \u0432 \u0447\u0451\u0440\u043d\u043e\u043c \u0441\u043f\u0438\u0441\u043a\u0435. \u0415\u0441\u043b\u0438 \u0434\u0430 \u2014 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044f \u043e\u0442\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442:",
    "technical_li1": "\u0412\u044b \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u0442\u043e\u043a\u0435\u043d\u044b",
    "technical_li2": "\u041d\u0438\u043a\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0442\u043e\u043a\u0435\u043d\u044b \u043d\u0430 \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u0430\u0434\u0440\u0435\u0441",
    "technical_li3": "DeFi-\u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441 \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u0442\u043e\u043a\u0435\u043d\u0430\u043c\u0438",
    "technical_li4": "\u0422\u043e\u043a\u0435\u043d\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0434\u043e\u0431\u0440\u0438\u0442\u044c \u0434\u043b\u044f \u0442\u0440\u0430\u0442 \u0442\u0440\u0435\u0442\u044c\u0438\u043c\u0438 \u043b\u0438\u0446\u0430\u043c\u0438",
    "technical_p3": "\u0417\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430. \u041d\u0438 \u043a\u043e\u0448\u0435\u043b\u0451\u043a, \u043d\u0438 DEX, \u043d\u0438 \u043c\u043e\u0441\u0442 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u044d\u0442\u043e \u043e\u0431\u043e\u0439\u0442\u0438. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0440\u0430\u0437\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c \u2014 \u044d\u043c\u0438\u0442\u0435\u043d\u0442 \u0434\u043e\u043b\u0436\u0435\u043d \u0432\u044b\u0437\u0432\u0430\u0442\u044c unblacklist.",
    "why_title": "\u041f\u043e\u0447\u0435\u043c\u0443 \u044d\u0442\u043e \u0432\u0430\u0436\u043d\u043e",
    "why_p1": "\u0421\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u044b \u2014 \u044d\u0442\u043e \u0431\u043e\u043b\u0435\u0435 $150 \u043c\u043b\u0440\u0434 \u0440\u044b\u043d\u043e\u0447\u043d\u043e\u0439 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438. \u041e\u043d\u0438 \u043e\u0441\u043d\u043e\u0432\u0430 DeFi, \u0442\u0440\u0430\u043d\u0441\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u044b\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439 \u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0442\u0440\u0435\u0439\u0434\u0438\u043d\u0433\u0430. \u041d\u043e \u043e\u043d\u0438 \u043d\u0435\u0441\u0443\u0442 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0438\u0441\u043a \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438.",
    "why_p2": "\u0424\u0443\u043d\u043a\u0446\u0438\u044f \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043e \u0432\u0430\u0448\u0438 \u0441\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0438\u043d\u044b \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442 \u0432\u0430\u043c, \u043f\u043e\u043a\u0430 \u044d\u043c\u0438\u0442\u0435\u043d\u0442 \u044d\u0442\u043e \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442. \u042d\u0442\u043e \u043d\u0435 \u0442\u0435\u043e\u0440\u0438\u044f \u2014 \u0442\u044b\u0441\u044f\u0447\u0438 \u0430\u0434\u0440\u0435\u0441\u043e\u0432 \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u044b, \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u044b \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u044b.",
    "why_p3": "stables.rip \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u044d\u0442\u0443 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u0438\u0434\u0438\u043c\u043e\u0439. \u041a\u0430\u0436\u0434\u0430\u044f \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0430 \u2014 \u0442\u043e\u0447\u043a\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0439 \u0446\u0435\u043d\u0437\u0443\u0440\u044b. \u041f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u044c \u2014 \u043f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433 \u043a \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438."
  },

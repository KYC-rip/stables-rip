    "card_blacklisted_body": "\u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u043e\u0434 \u0441\u0430\u043d\u043a\u0446\u0438\u044f\u043c\u0438 OFAC, \u0437\u0430\u043f\u0440\u043e\u0441\u044b \u043f\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u043f\u043e\u043c\u0435\u0442\u043a\u0438 \u00ab\u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u00bb, \u0430 \u0438\u043d\u043e\u0433\u0434\u0430 \u0438 \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435. \u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u043d\u0435\u043f\u0440\u043e\u0437\u0440\u0430\u0447\u0435\u043d \u2014 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0433\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430 \u043e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435\u0442.",
    "card_scale_title": "\u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b",
